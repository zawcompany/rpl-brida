# SIMPIL — contoh .env untuk docker-compose (DEV). Salin ke .env; JANGAN commit .env.
# Ganti semua <...>. APP_KEY: docker compose run --rm app php artisan key:generate --show
APP_NAME=SIMPIL
APP_ENV=local
APP_KEY=<hasil key:generate --show>
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr

# MySQL container (DB_HOST ditimpa menjadi "db" oleh docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=simpil
DB_USERNAME=simpil
DB_PASSWORD=<password-dev>
DB_ROOT_PASSWORD=<password-root-dev>

# Tanpa Redis di dev: sesi/cache/antrean di database
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Berkas di volume lokal (dev). Untuk uji S3 isi MANUSCRIPT_DISK=s3 + AWS_BUCKET + kredensial dev.
FILESYSTEM_DISK=local
MANUSCRIPT_DISK=local
COVER_DISK=public

MAIL_MAILER=log
