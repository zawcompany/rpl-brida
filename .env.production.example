# ============================================================================
# SIMPIL — contoh .env PRODUKSI (AWS EC2 + RDS MySQL + S3 + SES)
# Salin ke server sebagai .env, isi nilai rahasia, lalu: php artisan key:generate
# JANGAN commit berkas .env asli.
# ============================================================================

APP_NAME="SIMPIL BRIDA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://simpil.example.go.id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- HTTPS & proxy (SRS NF-02) ---
FORCE_HTTPS=true
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

BCRYPT_ROUNDS=12

# --- Database: AWS RDS MySQL ---
DB_CONNECTION=mysql
DB_HOST=simpil.xxxxxxxx.ap-southeast-3.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=simpil
DB_USERNAME=simpil_app
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem

# --- Sesi / cache / antrean (database; worker: supervisor `php artisan queue:work`) ---
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Penyimpanan dokumen privat: AWS S3 ---
# Di EC2 gunakan IAM Role (tanpa access key). Key hanya untuk lingkungan di luar AWS.
FILESYSTEM_DISK=local
MANUSCRIPT_DISK=s3
AWS_DEFAULT_REGION=ap-southeast-3
AWS_BUCKET=simpil-dokumen-prod
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Surel notifikasi: pilih SATU ---
# Opsi A — AWS SES (API; memakai IAM Role / key di atas; domain pengirim harus terverifikasi)
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="noreply@simpil.example.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# Opsi B — SMTP (mis. SES SMTP endpoint / SMTP instansi)
# MAIL_MAILER=smtp
# MAIL_HOST=email-smtp.ap-southeast-3.amazonaws.com
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME=
# MAIL_PASSWORD=
