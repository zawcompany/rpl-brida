# ============================================================================
# SIMPIL — .env PRODUKSI AWS  (12-factor: semua konfigurasi dari environment)
# Salin ke server sebagai .env (izin 640, pemilik deploy:www-data), lalu:
#   php artisan key:generate
# JANGAN commit berkas .env asli. Nilai berbentuk <...> wajib diganti.
# ============================================================================

APP_NAME="SIMPIL BRIDA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://simpil.example.go.id
BCRYPT_ROUNDS=12
JOURNAL_NAME="SIMPIL BRIDA Kota Makassar"

# --- Log: stderr (ditangkap journald/CloudWatch agent); tidak menulis berkas lokal ---
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- HTTPS di belakang ALB ---
FORCE_HTTPS=true
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=240

# --- Database: Amazon RDS MySQL (private subnet, TLS) ---
DB_CONNECTION=mysql
DB_HOST=<simpil-db.xxxxxxxx.ap-southeast-3.rds.amazonaws.com>
DB_PORT=3306
DB_DATABASE=simpil
DB_USERNAME=simpil_app
DB_PASSWORD=<password-kuat>
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem

# --- Redis: Amazon ElastiCache (cache + sesi + antrean) ---
REDIS_CLIENT=phpredis
REDIS_HOST=<simpil-redis.xxxxxx.cache.amazonaws.com>
REDIS_PORT=6379
REDIS_PASSWORD=<auth-token-bila-diaktifkan>
REDIS_SCHEME=tls                 # kosongkan bila enkripsi in-transit dimatikan
REDIS_PREFIX=simpil-
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_AFTER_COMMIT=true

# --- Penyimpanan berkas: web server stateless, semua berkas di S3 ---
FILESYSTEM_DISK=local
AWS_DEFAULT_REGION=ap-southeast-3
# Kredensial TIDAK diisi: SDK memakai IAM Role yang menempel pada instance EC2.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Dokumen (naskah, revisi, PDF final, catatan review): bucket PRIVAT
MANUSCRIPT_DISK=s3
AWS_BUCKET=simpil-docs-prod

# Sampul edisi (publik): bucket terpisah, dilayani CloudFront
COVER_DISK=s3_public
AWS_PUBLIC_BUCKET=simpil-covers-prod
AWS_PUBLIC_URL=https://<dxxxxxxxxxxxx>.cloudfront.net

# --- Surel: Amazon SES (API; memakai IAM Role) ---
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="noreply@simpil.example.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# Alternatif SMTP (ganti blok SES di atas bila perlu):
# MAIL_MAILER=smtp
# MAIL_HOST=email-smtp.ap-southeast-3.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=<smtp-user>
# MAIL_PASSWORD=<smtp-pass>
