# SIMPIL — contoh .env untuk docker-compose.ec2.yml (satu server). Salin ke .env di server; JANGAN commit .env.
# Buat nilai acak: openssl rand -hex 24 . APP_KEY: docker compose -f docker-compose.ec2.yml run --rm app php artisan key:generate --show
APP_NAME=SIMPIL
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://ISI-IP-PUBLIK-EC2

LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=simpil
DB_USERNAME=simpil
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Berkas di volume Docker lokal (tanpa S3)
FILESYSTEM_DISK=local
MANUSCRIPT_DISK=local
COVER_DISK=public

# --- Opsi: naskah di S3 (bucket PRIVAT). Ganti MANUSCRIPT_DISK=local di atas menjadi s3 dan isi: ---
# Jangan isi AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: kredensial dari IAM Role yang menempel di EC2.
# MANUSCRIPT_DISK=s3
# AWS_DEFAULT_REGION=ap-southeast-3
# AWS_BUCKET=simpil-docs-<ACCOUNT_ID>
# AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
