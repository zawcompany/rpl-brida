{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocsBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::simpil-docs-prod/*"
    },
    {
      "Sid": "DocsBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::simpil-docs-prod"
    },
    {
      "Sid": "CoversBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::simpil-covers-prod/*"
    },
    {
      "Sid": "CoversBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::simpil-covers-prod"
    },
    {
      "Sid": "SendMailViaSES",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "*"
    }
  ]
}
