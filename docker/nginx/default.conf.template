# SIMPIL — Nginx container. TLS dihentikan di ALB; container hanya melayani HTTP :80.
# ${PHP_FPM_HOST} diisi envsubst oleh image nginx (variabel lain seperti $uri dibiarkan).
server {
    listen 80 default_server;
    server_name _;
    root /var/www/html/public;
    index index.php;

    # Unggahan naskah maks. 10 MB (+overhead form) — sejalan dengan php.ini & FormRequest
    client_max_body_size 12M;

    charset utf-8;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # Aset Vite ber-hash: cache panjang
    location /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~ \.php$ {
        fastcgi_pass ${PHP_FPM_HOST}:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 60s;
    }

    # Tidak ada berkas tersembunyi yang dilayani
    location ~ /\.(?!well-known).* { deny all; }
}
